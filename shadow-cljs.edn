{:deps {:aliases [:plugin-build]}
 :builds
 {:engine      {:target           :esm
                :js-options       {:resolve {"process" false}}
                :compiler-options {:optimizations :simple}
                :output-dir       "dist"
                :modules          {:main {:entries [paradise.engine.matrix.core]}}}

  :push-worker {:target           :browser
                :js-options       {:resolve {"process" false}}
                :compiler-options {:optimizations  :simple
                                   :output-wrapper true}
                :output-dir       "dist-push"
                :devtools         {:enabled false}
                :modules          {:push-worker {:entries [paradise.engine.matrix.push-worker]}}}
  :call-driver
  {:target :esm
   :output-dir "dist-call"
   :js-options {:js-provider :import
                :resolve {"process" false}}
   :modules {:driver {:exports {createCallDriver paradise.engine.matrix.call-driver/createCallDriver}}}
   :compiler-options   {:optimizations      :simple
                        :output-feature-set :es2020}}}}

