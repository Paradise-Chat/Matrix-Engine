{
    "name": "@paradise/matrix-engine",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/matrix-engine.js",
    "scripts": {
        "build:libs": "clojure -X:deps prep",
        "build:cljs": "shadow-cljs release engine",
        "build:bundle": "esbuild build/main.js --bundle --format=esm --outfile=dist/engine.js --define:process.env.NODE_ENV=\"'production'\" --define:process=undefined",
        "build:wasm": "cp node_modules/ffi-bindings/src/generated/wasm-bindgen/index_bg.wasm dist/",
        "build:manifest": "cp config.edn dist/manifest.edn",
        "build": "pnpm run build:libs && pnpm run build:cljs && pnpm run build:bundle && pnpm run build:manifest && pnpm run build:wasm"
    },
    "dependencies": {
        "ffi-bindings": "^1.0.6",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "shadow-cljs": "^3.3.6"
    },
    "devDependencies": {
        "esbuild": "^0.28.1"
    },
    "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
    "pnpm": {
        "onlyBuiltDependencies": [
            "uniffi-bindgen-react-native"
        ]
    }
}
