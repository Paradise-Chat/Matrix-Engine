{
    "name": "@paradise/matrix-engine",
    "version": "0.2.0",
    "type": "module",
    "scripts": {
        "build:libs": "clojure -X${LOCAL:+:local-client}:deps prep ${LOCAL:+:force true}",
        "build:engine": "shadow-cljs ${LOCAL:+-A:local-client} release engine",
        "build:bundle": "esbuild build/main.js --bundle --format=esm --outfile=dist/engine-matrix.js --define:process.env.NODE_ENV=\"'production'\" --define:process=undefined",
        "build:push": "npx shadow-cljs ${LOCAL:+-A:local-client} release push-worker",
        "build:combine": "cat node_modules/paradise-matrix-push-crypto/dist/paradise_matrix_push_crypto_bundle.js build/push-worker.js > dist/push-matrix.js",
        "build:call": "npx shadow-cljs ${LOCAL:+-A:local-client} release call-driver",
        "build:driver": "esbuild build/driver.js --bundle --format=esm --outfile=dist/call-driver.js --define:process.env.NODE_ENV=\"'production'\"",
        "build:encoder": "cp node_modules/livekit-client/dist/livekit-client.e2ee.worker.mjs dist/call-encoder.js",
        "build:driver-encoder": "pnpm run build:call && pnpm run build:encoder && pnpm run build:driver",
        "build:copy": "cp build/main.js dist/engine.js",
        "build:wasm": "cp node_modules/ffi-bindings/src/generated/wasm-bindgen/index_bg.wasm dist/",
        "build:manifest": "cp config.edn dist/manifest.edn",
        "build:scratch": "pnpm run build:libs && pnpm run build:engine && pnpm run build:push && pnpm run build:combine && pnpm run build:driver-encoder && pnpm run build:bundle && pnpm run build:manifest && pnpm run build:wasm",
        "build": "pnpm run build:libs && pnpm run build:engine && pnpm run build:driver-encoder && pnpm run build:bundle && pnpm run build:manifest && pnpm run build:wasm",
        "build:local": "LOCAL=1 pnpm run build"
    },
    "dependencies": {
        "ffi-bindings": "^1.0.6",
        "livekit-client": "^2.9.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "shadow-cljs": "^3.3.6"
    },
    "devDependencies": {
        "esbuild": "^0.28.1",
        "paradise-matrix-push-crypto": "^0.1.0"
    },
    "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
    "pnpm": {
        "onlyBuiltDependencies": [
            "uniffi-bindgen-react-native"
        ]
    }
}
