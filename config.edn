{:module-id :engine-matrix
 :version "0.2.0"
 :deps-sym paradise/matrix-engine
 :config-key "matrix"
 :path "/engine-matrix.js"
 :shadow-module {:entries [paradise.engine.matrix.core]
                 :web-worker true
                 :depends-on #{:engine}
                 :exports {init paradise.engine.matrix.core/bootstrap}}

 ;; For dev, these files need to be readily available without needing Vite
 :copy-files [{:from "node_modules/ffi-bindings/src/generated-compat/wasm-bindgen/index_bg.wasm"
               :to "index_bg.wasm"}
              ;; might find a better handling for these, but this'll do for now
              {:from "dist/push-matrix.js"
               :to "push-matrix.js"}
              {:from "dist/call-driver.js"
               :to "call-driver.js"}
              {:from "dist/call-encoder.js"
               :to "call-encoder.js"}
 ]

 :engine-config
 {:login
  {:fields
   [{:id :homeserver :label "Homeserver" :type :text :default "https://matrix.org"}
    {:id :username   :label "Username" :type :text}
    {:id :password   :label "Password" :type :password}
    ;; Action is intended to inform the UI what method to trigger in the engine
    ;; So, great for complex flows
    {:id :sso        :label "Continue with SSO" :type :action :action-id :init-sso}]}

  :notifications
  {:notification-script "./push-matrix.js"}
  ;; maybe suffix these with the protocol name
  :calling
  {:driver-script "./call-driver.js"
   :encoder-script "./call-encoder.js"
   }}}
